<Window x:Class="LenovoLegionToolkit.Plugin.CustomFanCurve.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:LenovoLegionToolkit.Plugin.CustomFanCurve.Resources"
        Title="{x:Static res:Resource.ConfigurationTitle}" Width="580" Height="640"
        MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{x:Static res:Resource.CopyFanTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static res:Resource.CopyFanDescription}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <TextBlock Text="{x:Static res:Resource.CopyFrom}"/>
            <ComboBox x:Name="SourceFan" DisplayMemberPath="DisplayName" SelectionChanged="SourceFan_SelectionChanged" Margin="0,6,0,12"/>
            <TextBlock Text="{x:Static res:Resource.CopyTo}"/>
            <ItemsControl x:Name="TargetFans" Margin="0,6,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel>
                <Button Content="{x:Static res:Resource.CopyFanButton}" Click="Copy_Click" Padding="12,6" Margin="0,0,8,8"/>
                <Button Content="{x:Static res:Resource.ResetSelectedFan}" Click="ResetFan_Click" Padding="12,6" Margin="0,0,0,8"/>
            </WrapPanel>
            <Separator Margin="0,12"/>
            <TextBlock Text="{x:Static res:Resource.BackupTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static res:Resource.BackupDescription}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <WrapPanel>
                <Button Content="{x:Static res:Resource.ExportBackup}" Click="Export_Click" Padding="12,6" Margin="0,0,8,8"/>
                <Button Content="{x:Static res:Resource.ImportBackup}" Click="Import_Click" Padding="12,6" Margin="0,0,0,8"/>
            </WrapPanel>
            <Button Content="{x:Static res:Resource.OpenRecoveryBackups}" Click="OpenBackups_Click" HorizontalAlignment="Left" Padding="12,6"/>
            <Separator Margin="0,12"/>
            <Button Content="{x:Static res:Resource.ResetAllSettings}" Click="ResetAll_Click" HorizontalAlignment="Left" Padding="12,6"/>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</Window>
